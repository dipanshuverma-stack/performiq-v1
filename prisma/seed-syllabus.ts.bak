import { PrismaClient } from "@prisma/client";
import { ALL_SYLLABUS_TOPICS } from "../config/syllabus";

const prisma = new PrismaClient();

async function main() {
  console.log("🚀 Initializing PerformIQ Syllabus Data Syncer...");

  // 1. Soft-deprecate ALL topics first
  await prisma.topic.updateMany({
    data: { isActive: false },
  });

  // 2. Bulk upsert using transaction for better performance
  const upsertPromises = ALL_SYLLABUS_TOPICS.map((topic) =>
    prisma.topic.upsert({
      where: { id: topic.id },
      update: {
        name: topic.name,
        displayOrder: topic.displayOrder,
        isActive: true,
      },
      create: {
        id: topic.id,
        slug: topic.slug,
        subject: topic.subject,
        section: topic.section,
        name: topic.name,
        displayOrder: topic.displayOrder,
        isActive: true,
      },
    })
  );

  const results = await Promise.all(upsertPromises);

  console.log(`✅ Successfully synced ${results.length} active master topics.`);
}

main()
  .catch((e) => {
    console.error("❌ Seed exception: ", e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });