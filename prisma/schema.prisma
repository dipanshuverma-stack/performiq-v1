generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum MockType {
  PRELIMS
  MAINS
}

enum MistakeType {
  CONCEPTUAL
  SILLY
  GUESS
  TIME_MANAGEMENT
  CALCULATION
  QUESTION_MISREAD
}

enum RevisionStatus {
  UNRESOLVED
  IN_PROGRESS
  MASTERED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ─────────────────────────────────────────────────────────────────
// CORE SYSTEM MODELS
// ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  topicProgress           TopicProgress[]
  studySessions           StudySession[]
  tasks                   Task[]
  revisions               Revision[]
  mockTests               MockTest[]
  mockSubjectPerformances MockSubjectPerformance[]
  mockTopicPerformances   MockTopicPerformance[]
  mistakeEntries          MistakeEntry[]
  examProfiles            ExamProfile[]
  mistakes                Mistake[]
  notifications           Notification[]
  practiceSessions        PracticeSession[]
}

model TopicProgress {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  topicName String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topicName])
  @@index([userId, subject, completed])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  topic     String
  duration  Int
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Revision {
  id            String   @id @default(cuid())
  userId        String
  subject       String
  topic         String
  revisionCount Int      @default(0)
  nextRevision  DateTime
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, nextRevision])
}

// ─────────────────────────────────────────────────────────────────
// MOCK TEST ARCHITECTURE
// ─────────────────────────────────────────────────────────────────

model MockTest {
  id                   String                  @id @default(cuid())
  userId               String
  exam                 String
  title                String?
  mockType             MockType?
  score                Float
  totalQuestions       Int
  attemptedQuestions   Int                     @default(0)
  correctAnswers       Int                     @default(0)
  incorrectAnswers     Int                     @default(0)
  unattemptedQuestions Int                     @default(0)
  accuracy             Float
  percentile           Float?
  rank                 Int?
  duration             Int?
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectPerformances MockSubjectPerformance[]
  topicPerformances   MockTopicPerformance[]
  mistakes            MistakeEntry[]

  @@index([userId])
  @@index([mockType])
  @@index([createdAt])
}

model MockSubjectPerformance {
  id             String   @id @default(cuid())
  userId         String
  mockId         String
  subject        String
  totalQuestions Int
  attempted      Int
  correct        Int
  incorrect      Int
  score          Float
  accuracy       Float
  timeSpent      Int?
  createdAt      DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mock MockTest @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mockId])
  @@index([subject])
}

model MockTopicPerformance {
  id        String   @id @default(cuid())
  userId    String
  mockId    String
  subject   String
  topic     String
  correct   Int      @default(0)
  incorrect Int      @default(0)
  skipped   Int      @default(0)
  accuracy  Float
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mock MockTest @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mockId])
  @@index([subject])
  @@index([topic])
}

// ─────────────────────────────────────────────────────────────────
// DIAGNOSTIC MISTAKE ENGINE
// ─────────────────────────────────────────────────────────────────

model MistakeEntry {
  id          String    @id @default(cuid())
  userId      String
  subject     String
  topic       String
  question    String
  explanation String?
  source      String?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  MockTest   MockTest? @relation(fields: [mockTestId], references: [id])
  mockTestId String?

  @@index([userId])
  @@index([subject])
  @@index([topic])
  @@index([resolved])
}

model Mistake {
  id          String      @id @default(cuid())
  userId      String
  subject     String
  topic       String?
  question    String
  mistakeType MistakeType 
  notes       String?
  resolved    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subject])
  @@index([resolved])
}

// ─────────────────────────────────────────────────────────────────
// DRILL RUN ENGINE (Sprint 3 Specification Blueprint)
// ─────────────────────────────────────────────────────────────────

model PracticeSession {
  id                 String         @id @default(cuid())
  sessionUuid        String         // High-integrity trace key generated at the server boundary

  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject            String
  topic              String
  difficulty         Difficulty?    // Type-safe enum configuration: EASY • MEDIUM • HARD

  totalQuestions     Int
  correctQuestions   Int
  incorrectQuestions Int
  durationSeconds    Int
  accuracy           Float
  qpm                Float          // Questions Per Minute velocity index

  mistakeCount       Int            @default(0)
  revisionStatus     RevisionStatus @default(UNRESOLVED)
  confidenceScore    Int?           // Service layer mapping matrix: 1 to 5
  notes              String?        // Qualitative post-execution thoughts

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([userId, sessionUuid]) // Defends table against client transaction retries

  // Scoped compound indexes for real-time complex data dashboard queries
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, subject])
  @@index([userId, topic])
  @@index([userId, revisionStatus])
  @@index([userId, confidenceScore])

  @@map("practice_sessions")
}

// ─────────────────────────────────────────────────────────────────
// PLATFORM METADATA & IDENTITY MANAGEMENT
// ─────────────────────────────────────────────────────────────────

model ExamProfile {
  id         String   @id @default(cuid())
  userId     String
  name       String
  examType   String
  targetDate DateTime
  readiness  Float    @default(0)
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}