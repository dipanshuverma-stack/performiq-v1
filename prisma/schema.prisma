generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE AUTH.JS MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?

  accounts                Account[]
  sessions                Session[]
  examProfiles            ExamProfile[]
  mistakes                Mistake[]
  mistakeEntries          MistakeEntry[]
  mockSubjectPerformances MockSubjectPerformance[]
  mockTests               MockTest[]
  mockTopicPerformances   MockTopicPerformance[]
  notifications           Notification[]
  revisions               Revision[]
  studySessions           StudySession[]
  tasks                   Task[]
  topicProgress           TopicProgress[]
  practiceSessions        PracticeSession[]        @relation("UserToPracticeSessions")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// DOMAIN LEDGERS & BUSINESS METRICS
// ==========================================

model PracticeSession {
  id                 String         @id @default(cuid())
  sessionUuid        String         @map("session_uuid")
  userId             String         @map("user_id")
  subject            Subject
  topic              String
  difficulty         Difficulty?
  totalQuestions     Int            @map("total_questions")
  correctQuestions   Int            @map("correct_questions") // ✅ Restored & Cleaned
  incorrectQuestions Int            @map("incorrect_questions") // ✅ Restored & Cleaned
  durationSeconds    Int            @map("duration_seconds")
  accuracy           Float          @db.Real
  qpm                Float          @db.Real
  mistakeCount       Int            @default(0) @map("mistake_count")
  revisionStatus     RevisionStatus @default(UNRESOLVED) @map("revision_status")
  confidenceScore    Int?           @map("confidence_score")
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user User @relation("UserToPracticeSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionUuid])
  @@index([userId, confidenceScore])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, revisionStatus])
  @@index([userId, subject])
  @@index([userId, topic])
  @@map("practice_sessions")
}

model ExamProfile {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  examType   ExamType
  targetDate DateTime @map("target_date")
  readiness  Float    @default(0)
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([userId])
  @@map("exam_profiles")
}

model Mistake {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  subject     Subject
  topic       String?
  question    String      @db.Text
  notes       String?     @db.Text
  resolved    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  mistakeType MistakeType @map("mistake_type")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolved])
  @@index([subject])
  @@index([userId])
  @@map("mistakes")
}

model MistakeEntry {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  subject     Subject
  topic       String
  createdAt   DateTime   @default(now()) @map("created_at")
  explanation String?    @db.Text
  mockTestId  String?    @map("mock_test_id")
  question    String     @db.Text
  resolved    Boolean    @default(false)
  source      String?
  updatedAt   DateTime   @updatedAt @map("updated_at")
  difficulty  Difficulty @default(MEDIUM)

  mockTest MockTest? @relation(fields: [mockTestId], references: [id])
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolved])
  @@index([subject])
  @@index([topic])
  @@index([userId])
  @@map("mistake_entries")
}

model MockSubjectPerformance {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  mockId         String   @map("mock_id")
  subject        Subject
  totalQuestions Int      @map("total_questions")
  attempted      Int
  correct        Int      @map("correct_questions") // ✅ Realigned System Naming
  incorrect      Int      @map("incorrect_questions") // ✅ Realigned System Naming
  score          Float    @db.Real
  accuracy       Float    @db.Real
  timeSpent      Int?     @map("time_spent")
  createdAt      DateTime @default(now()) @map("created_at")

  mockTest MockTest @relation(fields: [mockId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mockId])
  @@index([subject])
  @@index([userId])
  @@map("mock_subject_performances")
}

model MockTest {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  exam                 ExamType
  title                String?
  mockType             MockType? @map("mock_type")
  score                Float     @db.Real
  totalQuestions       Int       @map("total_questions")
  attemptedQuestions   Int       @default(0) @map("attempted_questions")
  correctAnswers       Int       @default(0) @map("correct_answers") // ✅ Restored & Cleaned
  incorrectAnswers     Int       @default(0) @map("incorrect_answers") // ✅ Restored & Cleaned
  unattemptedQuestions Int       @default(0) @map("unattempted_questions")
  accuracy             Float     @db.Real
  percentile           Float?    @db.Real
  rank                 Int?
  duration             Int?
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  mistakeEntries      MistakeEntry[]
  subjectPerformances MockSubjectPerformance[]
  topicPerformances   MockTopicPerformance[]
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([mockType])
  @@index([userId])
  @@map("mock_tests")
}

model MockTopicPerformance {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  mockId             String   @map("mock_id")
  subject            Subject
  topic              String
  correctQuestions   Int      @default(0) @map("correct_questions") // ✅ Restored & Cleaned
  incorrectQuestions Int      @default(0) @map("incorrect_questions") // ✅ Restored & Cleaned
  skipped            Int      @default(0)
  accuracy           Float    @db.Real
  createdAt          DateTime @default(now()) @map("created_at")

  mockTest MockTest @relation(fields: [mockId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mockId])
  @@index([subject])
  @@index([topic])
  @@index([userId])
  @@map("mock_topic_performances")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([read])
  @@index([userId])
  @@map("notifications")
}

model Revision {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  subject       Subject
  topic         String
  revisionCount Int      @default(0) @map("revision_count")
  nextRevision  DateTime @map("next_revision")
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, nextRevision])
  @@map("revisions")
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  completed Boolean  @default(false)
  duration  Int
  subject   Subject
  topic     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_sessions")
}

model Task {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tasks")
}

model TopicProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  topicName String   @map("topic_name")
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  subject   Subject

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topicName])
  @@index([userId, subject, completed])
  @@map("topic_progresses")
}

// ==========================================
// ENUMS
// ==========================================

enum RevisionStatus {
  UNRESOLVED
  IN_PROGRESS
  MASTERED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
  MAINS
}

enum MistakeType {
  CONCEPTUAL
  SILLY
  GUESS
  TIME_MANAGEMENT
  CALCULATION
  QUESTION_MISREAD
}

enum MockType {
  PRELIMS
  MAINS
}

enum Subject {
  QUANTITATIVE_APTITUDE
  REASONING_ABILITY
  ENGLISH_LANGUAGE
  GENERAL_AWARENESS
  COMPUTER_AWARENESS
}

enum SectionType {
  PRELIMS
  MAINS
}

enum ExamType {
  IBPS_PO
  IBPS_CLERK
  SBI_PO
  SBI_CLERK
  RRB_PO
  RRB_CLERK
  RBI_ASSISTANT
  RBI_GRADE_B
  NABARD
  LIC_AAO
}
