generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}
model User {
  id                String @id @default(cuid())

  email             String @unique
  passwordHash      String?

  name              String?
  avatarUrl         String?

  role              UserRole @default(USER)

  timezone          String? @default("Asia/Kolkata")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  examSelections    UserExam[]
  studySessions     StudySession[]
  tasks             Task[]
  taskLogs          TaskLog[]

  mockAttempts      MockAttempt[]
  questionAttempts  QuestionAttempt[]

  mistakes          MistakeJournalEntry[]

  revisions         RevisionCard[]
  revisionReviews   RevisionReview[]

  notifications     Notification[]

  readinessHistory  ReadinessSnapshot[]

  achievements      UserAchievement[]

  streak            UserStreak?
}
enum UserRole {
  USER
  ADMIN
}

model UserExam {
  id          String   @id @default(cuid())

  userId      String

  examName    String
  targetYear  Int?

  isPrimary   Boolean  @default(false)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudySession {
  id                String   @id @default(cuid())

  userId            String

  title             String?

  durationMinutes   Int      @default(0)

  startedAt         DateTime
  endedAt           DateTime?

  notes             String?

  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id                String   @id @default(cuid())

  userId            String

  title             String
  description       String?

  completed         Boolean  @default(false)

  dueDate           DateTime?

  scheduledStart    DateTime?
  scheduledEnd      DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskLogs          TaskLog[]

  @@index([userId])
}

model TaskLog {
  id                String   @id @default(cuid())

  taskId            String
  userId            String

  durationMinutes   Int

  notes             String?

  createdAt         DateTime @default(now())

  task              Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model MockAttempt {
  id                String   @id @default(cuid())

  userId            String

  score             Float?
  percentage        Float?

  startedAt         DateTime?
  submittedAt       DateTime?

  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestionAttempt {
  id                String   @id @default(cuid())

  userId            String

  questionText      String

  isCorrect         Boolean

  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MistakeJournalEntry {
  id                String   @id @default(cuid())

  userId            String

  title             String

  mistakeReason     String?
  correctApproach   String?

  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RevisionCard {
  id                String   @id @default(cuid())

  userId            String

  front             String
  back              String

  easeFactor        Float    @default(2.5)
  intervalDays      Int      @default(0)
  repetition        Int      @default(0)

  dueDate           DateTime

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviews           RevisionReview[]

  @@index([userId])
  @@index([dueDate])
}

model RevisionReview {
  id                String   @id @default(cuid())

  revisionCardId    String
  userId            String

  rating            Int

  reviewedAt        DateTime @default(now())

  revisionCard      RevisionCard @relation(fields: [revisionCardId], references: [id], onDelete: Cascade)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([revisionCardId])
  @@index([userId])
}

model Notification {
  id                String   @id @default(cuid())

  userId            String

  title             String
  message           String

  isRead            Boolean  @default(false)

  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReadinessSnapshot {
  id                String   @id @default(cuid())

  userId            String

  overallScore      Float

  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAchievement {
  id                String   @id @default(cuid())

  userId            String

  title             String
  description       String?

  unlockedAt        DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserStreak {
  id                String   @id @default(cuid())

  userId            String   @unique

  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)

  lastActiveDate    DateTime?

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

