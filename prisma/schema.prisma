model User {
  id                String @id @default(cuid())

  email             String @unique
  passwordHash      String?

  name              String?
  avatarUrl         String?

  role              UserRole @default(USER)

  timezone          String? @default("Asia/Kolkata")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  examSelections    UserExam[]
  studySessions     StudySession[]
  tasks             Task[]
  taskLogs          TaskLog[]

  mockAttempts      MockAttempt[]
  questionAttempts  QuestionAttempt[]

  mistakes          MistakeJournalEntry[]

  revisions         RevisionCard[]
  revisionReviews   RevisionReview[]

  notifications     Notification[]

  readinessHistory  ReadinessSnapshot[]

  achievements      UserAchievement[]

  streak            UserStreak?

  // NEW
  dailyActivities   DailyActivity[]
}

model DailyActivity {
  id                String   @id @default(cuid())

  userId            String

  studyMinutes      Int      @default(0)

  revisionMinutes   Int      @default(0)

  tasksCompleted    Int      @default(0)

  testsTaken        Int      @default(0)

  questionsSolved   Int      @default(0)

  mockScoreAverage  Float?

  readinessScore    Float?

  date              DateTime

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, date])

  @@index([userId])
  @@index([date])
}