generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepeatType {
  NONE
  DAILY
  ALTERNATE
  EVERY_THREE_DAYS
  CUSTOM
}

model User {
  id                      String                   @id @default(cuid())
  email                   String?                  @unique
  name                    String?
  emailVerified           DateTime?                @map("email_verified")
  image                   String?
  plannerRows             Int                      @default(5)
  mockTopicInsights       MockTopicInsight[]
  rewardLogs              RewardLog[]
  rewardSummary           RewardSummary?
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]
  weeklyPlans             WeeklyPlan[]
  accounts                Account[]
  examProfiles            ExamProfile[]
  mistakeEntries          MistakeEntry[]
  mistakes                Mistake[]
  mockSubjectPerformances MockSubjectPerformance[]
  mockTests               MockTest[]
  notificationPreference  NotificationPreference?
  notifications           Notification[]
  practiceSessions        PracticeSession[]        @relation("UserToPracticeSessions")
  revisions               Revision[]
  sessions                Session[]
  studySessions           StudySession[]
  tasks                   Task[]
  topicProgress           TopicProgress[]
  achievements            UserAchievement[]

  @@map("users")
}

model Achievement {
  id           String              @id @default(cuid())
  key          String              @unique
  title        String
  description  String
  icon         String
  category     AchievementCategory
  rarity       AchievementRarity   @default(COMMON)
  rewardPoints Int                 @default(0)
  xp           Int                 @default(0)
  hidden       Boolean             @default(false)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  users        UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model RewardLog {
  id          String       @id @default(cuid())
  userId      String
  rewardType  RewardType
  action      RewardAction
  title       String
  description String?
  points      Float
  createdAt   DateTime     @default(now())
  sourceId    String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, sourceId])
}

model RewardSummary {
  id               String    @id @default(cuid())
  userId           String    @unique
  totalPoints      Float     @default(0)
  weeklyPoints     Float     @default(0)
  monthlyPoints    Float     @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  updatedAt        DateTime  @updatedAt
  month            Int?
  weekStart        DateTime?
  year             Int?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id          String              @id @default(cuid())
  userId      String              @unique
  balance     Float               @default(0)
  totalEarned Float               @default(0)
  totalSpent  Float               @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  userId       String
  type         WalletTransactionType
  source       WalletSource
  amount       Float
  balanceAfter Float
  title        String
  description  String?
  createdAt    DateTime              @default(now())
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model WeeklyPlan {
  id               String     @id @default(cuid())
  userId           String
  rowIndex         Int
  title            String
  time             String?
  repeatType       RepeatType @default(NONE)
  repeatWeekdays   String[]   @default([])
  completed        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  category         String?
  carryForward     Boolean    @default(false)
  plannedDate      DateTime
  carryForwardDays Int        @default(0)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  revisionDue      Boolean @default(true)
  weakTopicAlert   Boolean @default(true)
  mockReminder     Boolean @default(true)
  studyReminder    Boolean @default(true)
  achievementAlert Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ExamProfile {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  targetDate  DateTime  @map("target_date")
  readiness   Float     @default(0)
  isActive    Boolean   @default(false) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  attemptDate DateTime?
  examType    ExamType
  priority    Int       @default(1)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([userId])
  @@index([priority])
  @@map("exam_profiles")
}

model Task {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  title       String
  completed   Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  subject     Subject?
  topic       String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, completed])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@map("tasks")
}

model StudySession {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  completed   Boolean           @default(false)
  duration    Int
  topic       String
  sessionType StudySessionType?
  subject     Subject
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, subject])
  @@index([userId, topic])
  @@map("study_sessions")
}

model TopicProgress {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  topicName         String    @map("topic_name")
  completed         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  confidence        Int       @default(0)
  lastPracticedAt   DateTime?
  lastRevisedAt     DateTime?
  lastStudiedAt     DateTime?
  subject           Subject
  mistakeCount      Int       @default(0)
  mockAccuracy      Float     @default(0) @db.Real
  mockQuestions     Int       @default(0)
  practiceAccuracy  Float     @default(0) @db.Real
  practiceQuestions Int       @default(0)
  practiceSessions  Int       @default(0)
  revisionCount     Int       @default(0)
  lastSeenInMock    DateTime?
  mockStrongCount   Int       @default(0)
  mockWeakCount     Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, topicName])
  @@index([userId, subject, completed])
  @@map("topic_progresses")
}

model PracticeSession {
  id                 String         @id @default(cuid())
  sessionUuid        String         @map("session_uuid")
  userId             String         @map("user_id")
  topic              String
  difficulty         Difficulty?
  totalQuestions     Int            @map("total_questions")
  durationSeconds    Int            @map("duration_seconds")
  accuracy           Float          @db.Real
  qpm                Float          @db.Real
  mistakeCount       Int            @default(0) @map("mistake_count")
  revisionStatus     RevisionStatus @default(UNRESOLVED) @map("revision_status")
  confidenceScore    Int?           @map("confidence_score")
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")  
  correctQuestions   Int            @map("correct_questions")
  incorrectQuestions Int            @map("incorrect_questions")
  subject            Subject
  user               User           @relation("UserToPracticeSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionUuid])
  @@index([userId, confidenceScore])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, revisionStatus])
  @@index([userId, subject])
  @@index([userId, topic])
  @@map("practice_sessions")
}

model Mistake {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  topic       String?
  question    String
  notes       String?
  resolved    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @map("updated_at")
  mistakeType MistakeType @map("mistake_type")
  subject     Subject
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolved])
  @@index([subject])
  @@index([userId])
  @@map("mistakes")
}

model MistakeEntry {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  topic       String     @map("topic")
  createdAt   DateTime   @default(now()) @map("created_at")
  explanation String?
  mockTestId  String?    @map("mock_test_id")
  question    String
  resolved    Boolean    @default(false)
  source      String?
  updatedAt   DateTime   @updatedAt @map("updated_at")
  difficulty  Difficulty @default(MEDIUM)
  subject     Subject
  mockTest    MockTest?  @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resolved])
  @@index([subject])
  @@index([topic])
  @@index([userId])
  @@map("mistake_entries")
}

model MockSubjectPerformance {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  mockId            String             @map("mock_id")
  totalQuestions    Int                @map("total_questions")
  attempted         Int
  score             Float              @db.Real
  accuracy          Float              @db.Real
  timeSpent         Int?               @map("time_spent")
  createdAt         DateTime           @default(now()) @map("created_at")
  correct           Int                @map("correct_questions")
  incorrect         Int                @map("incorrect_questions")
  subject           Subject
  mockTopicInsights MockTopicInsight[]
  mockTest          MockTest           @relation(fields: [mockId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mockId])
  @@index([subject])
  @@index([userId])
  @@map("mock_subject_performances")
}

model MockTest {
  id                   String                   @id @default(cuid())
  userId               String                   @map("user_id")
  title                String?
  mockType             MockType?                @map("mock_type")
  score                Float                    @db.Real
  totalQuestions       Int                      @map("total_questions")
  attemptedQuestions   Int                      @default(0) @map("attempted_questions")
  unattemptedQuestions Int                      @default(0) @map("unattempted_questions")
  accuracy             Float                    @db.Real
  percentile           Float?                   @db.Real
  rank                 Int?
  duration             Int?
  notes                String?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  correctAnswers       Int                      @default(0) @map("correct_answers")
  incorrectAnswers     Int                      @default(0) @map("incorrect_answers")
  exam                 ExamType
  mockTopicInsights    MockTopicInsight[]
  mistakeEntries       MistakeEntry[]
  subjectPerformances  MockSubjectPerformance[]
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([mockType])
  @@index([userId])
  @@map("mock_tests")
}

model MockTopicInsight {
  id                       String                  @id @default(cuid())
  userId                   String
  mockId                   String
  subject                  Subject
  topic                    String
  type                     TopicInsightType
  createdAt                DateTime                @default(now())
  mockSubjectPerformanceId String?
  mock                     MockTest                @relation(fields: [mockId], references: [id], onDelete: Cascade)
  MockSubjectPerformance   MockSubjectPerformance? @relation(fields: [mockSubjectPerformanceId], references: [id])
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, subject])
  @@index([userId, subject, topic])
  @@index([mockId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([read])
  @@index([userId])
  @@map("notifications")
}

model Revision {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  topic         String
  revisionCount Int      @default(0) @map("revision_count")
  nextRevision  DateTime @map("next_revision")
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  subject       Subject
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, nextRevision])
  @@map("revisions")
}

enum RewardType {
  PLANNER
  PRACTICE
  MOCK
  STREAK
  WEEKLY_BONUS
  MONTHLY_BONUS
}

enum RewardAction {
  EARN
  PENALTY
  BONUS
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletSource {
  PRACTICE
  MOCK
  PLANNER
  STREAK
  ACHIEVEMENT
  BONUS
  MANUAL_ADD
  MANUAL_REMOVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum StudySessionType {
  STUDY
  REVISION
  PRACTICE
  MOCK_ANALYSIS
}

enum RevisionStatus {
  UNRESOLVED
  IN_PROGRESS
  MASTERED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
  MAINS
}

enum MistakeType {
  CONCEPTUAL
  SILLY
  GUESS
  TIME_MANAGEMENT
  CALCULATION
  QUESTION_MISREAD
}

enum MockType {
  PRELIMS
  MAINS
}

enum Subject {
  QUANTITATIVE_APTITUDE
  REASONING_ABILITY
  ENGLISH_LANGUAGE
  GENERAL_AWARENESS
  COMPUTER_AWARENESS
}

enum SectionType {
  PRELIMS
  MAINS
}

enum ExamType {
  IBPS_PO
  IBPS_CLERK
  SBI_PO
  SBI_CLERK
  RRB_PO
  RRB_CLERK
  RBI_ASSISTANT
  RBI_GRADE_B
  NABARD
  LIC_AAO
}

enum TopicInsightType {
  WEAK
  STRONG
  SKIPPED
}

enum AchievementCategory {
  PLANNER
  PRACTICE
  MOCK
  STREAK
  REWARD
  REVISION
  SPECIAL
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}